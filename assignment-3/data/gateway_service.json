{
  "service_name": "gateway-service",
  "version": "3.1.2",
  "network": {
    "host": "0.0.0.0",
    "port": 443,
    "protocol": "HTTPS"
  },
  "security": {
    "tls_enabled": true,
    "compliance": ["HIPAA", "SOC2_TYPE_II", "FEDRAMP_MODERATE"],
    "waf_enabled": true
  },
  "rate_limiting": {
    "enabled": true,
    "requests_per_second": 10000,
    "burst_capacity": 20000,
    "algorithm": "sliding_window_counter"
  }
}
